# --- Database (matches docker-compose.yml; host port 5433 avoids clashing with a local Postgres) ---
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/agent_workspace

OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3.5:4b

# --- Agent execution limits ---
AGENT_MAX_TURNS=12
AGENT_RUN_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_RETRIES=2
TOOL_RESULT_MAX_CHARS=6000
AGENT_MAX_REVISIONS=1

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

OPENAI_BASE_URL=http://localhost:11434/v1

STT_DEVICE=auto

DIARIZE_THRESHOLD=0.7

PROVENANCE_GUARD=1
# OPENAI_MODEL=scripted:auto runs the demo without an LLM.
