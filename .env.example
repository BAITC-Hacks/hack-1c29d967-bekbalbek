# --- Database (matches docker-compose.yml; host port 5433 avoids clashing with a local Postgres) ---
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/agent_workspace

# --- Model (backend only; never shipped to the browser) ---
# Leave the key empty and the model on scripted:auto for the deterministic demo (no provider calls).
# Once you have a key, paste it here and set OPENAI_MODEL to a real model, e.g. gpt-5.4-mini.
OPENAI_API_KEY=
OPENAI_MODEL=scripted:auto

# --- Agent execution limits ---
AGENT_MAX_TURNS=12
AGENT_RUN_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_RETRIES=2
TOOL_RESULT_MAX_CHARS=6000
AGENT_MAX_REVISIONS=1

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
